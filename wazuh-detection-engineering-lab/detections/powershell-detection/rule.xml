<!--
  PowerShell Local Account Discovery

  MITRE ATT&CK:
  T1087.001 - Account Discovery: Local Account

  Telemetry:
  Sysmon Event ID 1 - Process Create

  Detects Get-LocalUser executed through powershell.exe.
-->

<group name="windows,sysmon,powershell,account_discovery,">

  <rule id="100101" level="8">

    <if_group>sysmon_event1</if_group>

    <field name="win.eventdata.image" type="pcre2">
      (?i)\\powershell\.exe$
    </field>

    <field name="win.eventdata.commandLine" type="pcre2">
      (?i)\bGet-LocalUser\b
    </field>

    <description>
      Custom detection: PowerShell local account discovery using Get-LocalUser
    </description>

    <mitre>
      <id>T1087.001</id>
    </mitre>

  </rule>

</group>